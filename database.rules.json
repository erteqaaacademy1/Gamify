{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('host').val() === auth.uid || (!data.exists() && newData.child('host').val() === auth.uid))",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/'+$pin+'/status').val() === 'lobby' && (!newData.exists() || (root.child('rooms/'+$pin+'/cfg/regOpen').val() === true && (!data.exists() || root.child('rooms/'+$pin+'/cfg/switchOpen').val() === true) && root.child('rooms/'+$pin+'/cfg/teams/'+newData.child('team').val()).exists()))",
            ".validate": "newData.hasChildren(['n','team']) && newData.child('n').isString() && newData.child('n').val().length > 0 && newData.child('n').val().length <= 20 && newData.child('team').isString()"
          }
        },
        "subs": {
          "$qk": {
            "$tk": {
              ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid && root.child('rooms/'+$pin+'/players/'+auth.uid+'/team').val() === $tk && root.child('rooms/'+$pin+'/st/ph').val() === 'answer' && root.child('rooms/'+$pin+'/st/qk').val() === $qk",
              ".validate": "newData.hasChildren(['a','by']) && ((newData.child('a').isNumber() && newData.child('a').val() >= 0 && newData.child('a').val() <= 5) || (newData.child('a').isString() && newData.child('a').val().length <= 200) || (newData.child('a').hasChildren() && newData.child('a').numChildren() <= 8))"
            }
          }
        },
        "pres": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          }
        }
      }
    },
    "games": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "updatedAt",
          "createdAt"
        ]
      }
    },
    "gameContent": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "stats": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "sessionIdx": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": [
          "updatedAt",
          "createdAt"
        ]
      }
    }
  }
}
